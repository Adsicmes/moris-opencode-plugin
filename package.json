{
  "name": "@moris/opencode-plugin",
  "version": "0.1.0",
  "description": "Moris LLM Gateway provider for OpenCode v2: one 'moris' provider, gateway-synced models, no automatic retries.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
